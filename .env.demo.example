# Safe standalone Desk demo: uses a separate local SQLite file, with all
# capabilities that can reach the host or a third party turned off.
VELORA_HOST=127.0.0.1
VELORA_PORT=8031
VELORA_DATABASE_URL=sqlite+aiosqlite:///./velora_data/demo.db

# The empty Desk is still usable without an LLM key. Add a compatible provider
# only when you intentionally want to demonstrate a live response.
VELORA_LLM_BASE_URL=https://api.openai.com/v1
VELORA_LLM_API_KEY=
VELORA_LLM_MODEL=gpt-4o-mini

VELORA_START_MEMORY_SIDECAR=false
VELORA_MCP_ENABLED=false
VELORA_REMINDERS_ENABLED=false
VELORA_COMPUTER_ENABLED=false
VELORA_WEB_SEARCH_ENABLED=false
