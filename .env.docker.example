# Copy this file to .env.docker, then use --env-file .env.docker with Compose.
# The demo stack starts without a key, but an OpenAI-compatible provider is
# required before sending chats or letting memory consolidate conversations.
VELORA_LLM_BASE_URL=https://api.openai.com/v1
VELORA_LLM_API_KEY=
VELORA_LLM_MODEL=gpt-4o-mini

# Leave empty for an entirely local Compose network. If set, both services use
# this value when calling atom-memory.
VELORA_ATOM_MEMORY_API_KEY=
