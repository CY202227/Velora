VELORA_HOST=127.0.0.1
VELORA_PORT=8030

# Persistence: SQLite (default) or MySQL
# SQLite:
# VELORA_DATABASE_URL=sqlite+aiosqlite:///./velora_data/velora.db
# MySQL:
# VELORA_DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/velora
# Also accepted: mysql://user:password@host:3306/velora

VELORA_LLM_BASE_URL=https://api.openai.com/v1
VELORA_LLM_API_KEY=
VELORA_LLM_MODEL=gpt-4o-mini
VELORA_ATOM_MEMORY_BASE_URL=http://127.0.0.1:8020
VELORA_ATOM_MEMORY_API_KEY=
VELORA_MEMORY_SPACE_UID=velora-default

# Local preset (presets/local-default.json): install with pip install -e ".[memory]"
# then set true to spawn atom-memory on :8020 if not already running.
VELORA_PRESET_ID=local-default
VELORA_START_MEMORY_SIDECAR=false
# Default warmth for new sessions: 0=more assistant, 100=more companion
VELORA_DEFAULT_WARMTH=35
# Per-turn memory recall/write hints in Desk
VELORA_SHOW_MEMORY_HINTS=true

# Explicit reminders (Desk / 「请提醒：… | ISO」); quiet hours use user timezone
VELORA_REMINDERS_ENABLED=true
VELORA_REMINDER_POLL_SECONDS=20
VELORA_USER_TIMEZONE=Asia/Shanghai
VELORA_QUIET_HOURS_ENABLED=true
VELORA_QUIET_HOURS_START=22:00
VELORA_QUIET_HOURS_END=08:00

# Function calling: max tool rounds per turn before forcing a text reply
VELORA_MAX_TOOL_ROUNDS=4

# MCP (AstrBot-compatible JSON; Desk can CRUD + hot reload)
# Copy presets/mcp_server.example.json → velora_data/mcp_server.json and set active:true
VELORA_MCP_ENABLED=true
VELORA_MCP_CONFIG_PATH=./velora_data/mcp_server.json

# Local computer tools (session workspace under velora_data/workspaces/)
VELORA_COMPUTER_ENABLED=true
VELORA_COMPUTER_SHELL=powershell
VELORA_COMPUTER_TIMEOUT_SECONDS=60
VELORA_COMPUTER_ALLOW_ABS_PATHS=false
VELORA_WORKSPACES_DIR=./velora_data/workspaces

# Skills (SKILL.md under each subfolder; seed copies presets/skills/hello if empty)
VELORA_SKILLS_DIR=./velora_data/skills

# Web search (Tavily)
VELORA_WEB_SEARCH_ENABLED=true
VELORA_TAVILY_API_KEY=

VELORA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
